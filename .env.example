# ================= ENVIRONMENT =================
# Copy to .env.local for local dev, and set the same VITE_* values as repo
# "Actions" secrets/variables for the GitHub Pages build.

# Which backend to use:
#   "local"    (default) — localStorage, no server
#   "api"      — shared SQLite via the server/ (libSQL/Turso)
#   "firebase" — parked
VITE_BACKEND=local

# ---- api mode (DynamoDB server in server/) ----
VITE_API_BASE=
# Optional shared key; must match the server's API_KEY.
VITE_API_KEY=

# ---- Google SSO (optional; needs api mode + the server) ----
# OAuth Client ID (public). Set the SAME value as the server's GOOGLE_CLIENT_ID.
# When set, sign-in uses "Sign in with Google"; empty = shared-password gate.
VITE_GOOGLE_CLIENT_ID=

# ---- Firebase (only needed when VITE_BACKEND=firebase) ----
# From Firebase console → Project settings → Your apps → SDK setup & config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Region your Cloud Functions are deployed to (default us-central1).
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Restrict sign-in to this email domain.
VITE_ALLOWED_EMAIL_DOMAIN=fuseenergy.com

# ---- Static-build AI fallback (only when VITE_BACKEND=local) ----
# Optional: your own backend proxy that forwards to the Claude API.
VITE_CHAT_ENDPOINT=

# ================= SERVER SECRET (Cloud Functions) =================
# NOT a VITE_ var — set with:  firebase functions:secrets:set ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=
