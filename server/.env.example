# ---- DynamoDB (ticket storage) ----
# In AWS (App Runner / ECS) credentials + region come from the task IAM role —
# you do NOT set AWS keys here. These are the only DB vars you may want to set:
# DDB_TABLE=access_desk_tickets        # table name (default shown)
# AWS_REGION=eu-west-2                  # usually injected by the platform
# DDB_AUTOCREATE=false                  # set if your infra team provisions the table

# Local dev against DynamoDB Local (optional):
# DDB_ENDPOINT=http://localhost:8000
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=local              # any value; DynamoDB Local ignores it
# AWS_SECRET_ACCESS_KEY=local

# Optional shared key the client must send as x-api-key (deterrent, not real auth).
# API_KEY=some-long-random-string

# Restrict browser origins (recommended in prod):
# CORS_ORIGIN=https://arunselvan2506.github.io

# PORT=8787

# ---- AI triage (optional) ----
# The Anthropic key lives ONLY here, server-side. Never put it in the web app's
# VITE_* vars or commit it — anyone could read it from the static bundle.
# Prefer AWS Secrets Manager / SSM and inject it as ANTHROPIC_API_KEY at runtime.
# Without it, the AI triage feature is simply hidden.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8   # optional override

# ---- Google SSO (optional) ----
# Verifies Google ID tokens and restricts sign-in to your domain. Only the
# OAuth *Client ID* is needed (public) — no client secret for this flow.
# Set the SAME id as the web app's VITE_GOOGLE_CLIENT_ID. Without it, the app
# uses the shared-password gate.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# AUTH_DOMAIN=fuseenergy.com

# ---- Mention email notifications (optional, Amazon SES) ----
# Tagging someone in a comment emails them. Needs a verified SES sender.
# The instance IAM role needs ses:SendEmail. Without SES_FROM, this is disabled.
# SES_FROM=access-desk@fuseenergy.com   # verified SES sender/identity
# APP_URL=https://arunselvan2506.github.io/Access-request/   # link in the email
#                                       # (defaults to CORS_ORIGIN if set)
